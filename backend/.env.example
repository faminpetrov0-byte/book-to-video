# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# Redis (for Bull queue)
REDIS_URL=redis://localhost:6379

# AI Services (all free tier)
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxx
FAL_API_KEY=fal_xxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=el_xxxxxxxxxxxxxxxxxxxxx

# Coqui TTS (free, open-source) - requires: pip install TTS
COQUI_ENABLED=false
COQUI_MODEL=xtts_v2

# File limits
MAX_UPLOAD_SIZE_MB=50
MAX_SCENES_PER_PROJECT=30

# FFmpeg
FFMPEG_PATH=ffmpeg
